# SRA configuration file.
# Install as /etc/sra/sra.conf (or pass an explicit path with
# 'sra --config /path/to/sra.conf').
#
# Format: key = value, one per line.
# '#' starts a comment.
# Unknown keys and malformed lines are reported and abort startup.

# MIDI rawmidi addresses (Linux).  Use 'amidi -l' to list them.
# Both are required in daemon mode.
in  = hw:5,0
out = hw:5,1

# Channel reserved for chord input.
# Range: 1..16 (1-based, matching the number shown in the UI as
# "Chord Ch").  Default: 3.
#
# Internally SRA stores this as 0..15, but the configuration file
# and the --chord-ch command line option always use 1..16.
chord_ch = 3

# Command key zone shift: -1, 0, or +1.  Matches the [O] parameter
# in the interactive setup screen.  Use +1 for 76-key keyboards,
# -1 for 49-key keyboards.
# Default: 0  (61-key).
ctrl_offset = 0
